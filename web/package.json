{
  "name": "flyfish-dev",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "images:compress": "node scripts/optimize-images.mjs --apply",
    "test:images": "node scripts/optimize-images.mjs",
    "dev:lowcode": "npm --prefix lowcode run dev",
    "preview:storefront": "node scripts/preview-storefront.mjs",
    "build:lowcode": "npm --prefix lowcode run build",
    "build:lowcode:docker": "npm --prefix lowcode run build -- --base=/lowcode/",
    "build:docker": "npm run test:images && npm run sync:file-viewer && vite build --base=/ --outDir=dist-docker",
    "test:unit": "node --test scripts/test-*.mjs",
    "test:storefront": "node --test scripts/test-storefront-boundaries.mjs scripts/test-storefront-collections.mjs",
    "build:xianyu": "npm run sync:file-viewer && vite build --config vite.xianyu.config.js && node scripts/package-xianyu.mjs",
    "test:xianyu": "node --test scripts/test-xianyu.mjs",
    "dev": "vite",
    "sync:file-viewer": "node scripts/sync-file-viewer.mjs",
    "prebuild": "npm run test:images && node scripts/sync-file-viewer.mjs",
    "postbuild": "node scripts/build-static-release.mjs",
    "test:architecture": "node scripts/check-architecture.mjs",
    "test:build-artifacts": "node scripts/check-build-artifacts.mjs",
    "test:static-bootstrap": "node --test scripts/test-static-bootstrap.mjs",
    "test:oauth-intent": "node --test scripts/test-oauth-login-intent.mjs",
    "test:shop-i18n": "node --test scripts/test-shop-order-form-i18n.mjs",
    "test:shop-promotion": "node --test scripts/test-shop-promotion.mjs",
    "test:shop-offer-link": "node --test scripts/test-shop-offer-link.mjs",
    "test:shop-catalog": "node --test scripts/test-shop-catalog-redirect.mjs",
    "test:service-renewal-copy": "node --test scripts/test-service-renewal-copy.mjs",
    "test:shop-home": "node --test scripts/test-shop-home.mjs",
    "test:delivery-experience": "node --test scripts/test-delivery-experience.mjs",
    "test:route-smoke": "node scripts/smoke-route-capabilities.mjs",
    "build": "vite build",
    "preview:split": "node scripts/serve-split-build.mjs",
    "preview": "vite preview"
  },
  "type": "module",
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@surely-vue/table": "^4.2.9",
    "@vueuse/core": "^10.9.0",
    "ant-design-vue": "^4.1.2",
    "emoji-picker-element": "^1.29.1",
    "md-editor-v3": "^6.5.6",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "qs": "^6.16.1",
    "sortablejs": "^1.15.2",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "vite": "^5.0.12"
  },
  "overrides": {
    "linkify-it": "5.0.2",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "markdown-it": "14.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.31",
    "source-map-js": "1.2.2"
  }
}
