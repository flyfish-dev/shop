# Tower-only deployment. All live switches remain false until acceptance.
FLYFISH_XIANYU_PORT=10083
XIANYU_DATABASE_URL=
XIANYU_DATABASE_USER=
XIANYU_DATABASE_PASSWORD=
XIANYU_TOWER_DEPLOYMENT=false
XIANYU_DATA_FLOW_APPROVED=false
XIANYU_SALES_ENABLED=false
XIANYU_PROCESSING_ENABLED=false
XIANYU_MINIAPP_ENABLED=false
XIANYU_BRIDGE_ENABLED=false
# Base64 of exactly 32 random bytes. Tower only. Back up separately.
XIANYU_ENCRYPTION_KEY=
# At least 32 random characters; shared only across approved peers.
XIANYU_BRIDGE_SECRET=
XIANYU_AUTH_BRIDGE_URL=
XIANYU_SHOP_BRIDGE_URL=
XIANYU_MANAGEMENT_BRIDGE_URL=
# Exact allowed origins, comma-separated; never '*'.
XIANYU_ALLOWED_ORIGINS=
XIANYU_COMMERCE_APP_KEY=
XIANYU_COMMERCE_APP_SECRET=
XIANYU_BUYER_APP_KEY=
XIANYU_BUYER_APP_SECRET=
XIANYU_SELLER_APP_KEY=
XIANYU_SELLER_APP_SECRET=
XIANYU_MINIAPP_SELLER=
XIANYU_NATIVE_SELLER=
XIANYU_GENERIC_ITEM_ID=
XIANYU_BUSINESS_CODE=
XIANYU_VIRTUAL_ITEM_CODE=
XIANYU_MINIAPP_ENTRY_URL=
# Build-time public URL, not a secret. Must be an approved Tower HTTPS endpoint.
VITE_XIANYU_API_BASE=
